{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["warn", "single"],
    "indent": ["warn", 4],
    "no-implicit-globals": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "globals": {
    "THREE": "readonly",
    "CANNON": "readonly",
    "performance": "readonly",
    "localStorage": "readonly",
    "devicePixelRatio": "readonly"
  }
}
